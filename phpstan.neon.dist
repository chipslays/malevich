includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    paths:
        - src
        - config
    tmpDir: build/phpstan
    # The package's config/ is not the application's config directory, so the
    # rule would flag the usual env() defaults of a published config file.
    noEnvCallsOutsideOfConfig: false
